# --- Database (PostgreSQL, used by Prisma) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME"

# --- JWT Auth ---
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="15m"

# --- Firebase (client-side, values from Firebase console) ---
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

# --- Cloudinary (image upload) ---
CLOUDINARY_CLOUD_NAME=""

# --- Fraud model ---
# Base URL of the FastAPI model service (final_production_model/production).
# Set it and scoring goes over HTTP against a model that stays loaded in
# memory: a batch costs roughly 80ms instead of several seconds.
# Leave it unset and scoring falls back to spawning python per call, which
# needs no extra service running but pays the model load cost every time.
# Both paths produce identical scores.
#   Start the service with: npm run model-api
MODEL_API_URL="http://localhost:8000"
